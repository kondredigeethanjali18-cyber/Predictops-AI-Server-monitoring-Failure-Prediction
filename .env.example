# =====================================================================
# PredictOps AI - Environment Configuration
# =====================================================================

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials
MONGO_URI=mongodb+srv://<vamsikrishna>:<Vamsi@2005>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority

# Database Name
MONGO_DB=predictops

# Kafka Broker (default: kafka:9092 for docker, localhost:9092 for local)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OAuth 2.0 Base URL
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# =====================================================================
# SMTP Email Verification Configuration (Google 2-Step OTP Delivery)
# =====================================================================
# For Gmail, generate an App Password from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your.email@gmail.com
SMTP_FROM_NAME=PredictOps AI Security
SMTP_USE_TLS=true
SMTP_USE_SSL=false
